# ---------- app ----------
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- LLM ----------
# groq | gemini | openai | ollama | none
# Default: Groq running gpt-oss-120b (open weights, free tier, tool calling).
# Without GROQ_API_KEY the app automatically falls back to the built-in
# rule-based agent, so it still works with nothing configured.
LLM_PROVIDER=groq

# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# https://console.groq.com/keys  (free tier, open weights, supports tool calling)
# Model IDs change. Check https://console.groq.com/docs/models if you get a 404.
# Needs: pip install langchain-groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fully local open-weights via Ollama. No key, nothing leaves your machine.
# Needs: pip install langchain-ollama, then `ollama pull llama3.1:8b`
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ---------- weather ----------
# Optional. Without it the app uses Open-Meteo, which needs no key.
# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# ---------- database ----------
# Leave blank unless you actually installed Postgres + PostGIS.
DATABASE_URL=

# ---------- alert thresholds ----------
RAIN_FLASH_FLOOD_MM_HR=100
RAIN_WATCH_MM_HR=40
PRESSURE_DROP_HPA_3H=5
CYCLONE_WIND_KMH=60
HEATWAVE_DEPARTURE_C=4.5
ALERT_POLL_SECONDS=120
